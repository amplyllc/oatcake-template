<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">

<!-- Metadata -->
<meta name="description" content="{{ description or 'A lightweight component library for marketing sites, web apps, and mobile shells.' }}">
<meta name="author" content="{{ author or 'Your Organization' }}">
<meta name="keywords" content="{{ keywords or 'template, components, 11ty, nunjucks, sass' }}">
<meta name="robots" content="index, follow">
<meta name="color-scheme" content="dark light">

<!-- Theme & Branding -->
<meta name="theme-color" content="{{ themeColor or '#0f0f0f' }}">
<meta name="msapplication-TileColor" content="{{ tileColor or '#0f0f0f' }}">
<meta name="msapplication-config" content="/browserconfig.xml">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="{{ title or 'Template Library' }}">

<!-- Favicon & Icons -->
<link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
<link rel="manifest" href="/manifest.json">

<!-- Preconnect -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<!-- Fonts -->
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

<!-- Styles -->
<link rel="stylesheet" href="/styles/main.css">

<!-- Open Graph -->
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:title" content="{{ title or 'Template Library' }}">
<meta property="og:description" content="{{ description or 'A lightweight component library for marketing sites, web apps, and mobile shells.' }}">
<meta property="og:url" content="{{ canonicalUrl or 'https://example.com' }}">
<meta property="og:site_name" content="{{ siteName or 'Template Library' }}">
{% if ogImage %}<meta property="og:image" content="{{ ogImage }}">{% endif %}
{% if ogImageAlt %}<meta property="og:image:alt" content="{{ ogImageAlt }}">{% endif %}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title or 'Template Library' }}">
<meta name="twitter:description" content="{{ description or 'A lightweight component library for marketing sites, web apps, and mobile shells.' }}">
{% if twitterHandle %}<meta name="twitter:creator" content="@{{ twitterHandle }}">{% endif %}
{% if ogImage %}<meta name="twitter:image" content="{{ ogImage }}">{% endif %}

<!-- Canonical URL -->
{% if canonicalUrl %}<link rel="canonical" href="{{ canonicalUrl }}">{% endif %}

<!-- Alternate Links -->
{% if alternateLocales %}
  {% for locale in alternateLocales %}
    <link rel="alternate" hreflang="{{ locale.code }}" href="{{ locale.url }}">
  {% endfor %}
{% endif %}

<!-- Schema.org JSON-LD -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "{{ siteName or 'Template Library' }}",
  "url": "{{ canonicalUrl or 'https://example.com' }}",
  "description": "{{ description or 'A lightweight component library' }}",
  {% if ogImage %}"logo": "{{ ogImage }}",{% endif %}
  "sameAs": [
    {% if social.twitter %}"https://twitter.com/{{ social.twitter }}"{% endif %}
    {% if social.github %}"https://github.com/{{ social.github }}"{% endif %}
  ]
}
</script>

{% if schemaEvent %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Event",
  "name": "{{ schemaEvent.name }}",
  "description": "{{ schemaEvent.description }}",
  "startDate": "{{ schemaEvent.startDate | dateISO }}",
  "endDate": "{{ schemaEvent.endDate | dateISO }}",
  "location": {
    "@type": "Place",
    "name": "{{ schemaEvent.locationName }}",
    "address": "{{ schemaEvent.locationAddress }}"
  },
  "image": "{{ schemaEvent.image }}",
  "organizer": {
    "@type": "Organization",
    "name": "{{ siteName or 'Template Library' }}",
    "url": "{{ canonicalUrl or 'https://example.com' }}"
  }
}
</script>
{% endif %}

<!-- AI & Search Engine Directives -->
<meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<meta name="bingbot" content="index, follow">
<meta name="ai-content-creators" content="crawl-permitted">
