<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or site.title }}</title>
<meta name="description" content="{{ description or site.description }}">
<meta name="author" content="{{ site.author }}">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<meta name="color-scheme" content="light dark">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

<link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
<link rel="manifest" href="/manifest.json">
<meta name="msapplication-config" content="/browserconfig.xml">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="{{ site.title }}">
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM site summary">

<link rel="stylesheet" href="/styles/main.css">

<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.title }}">
{% if ogImage %}<meta property="og:image" content="{{ ogImage }}">{% endif %}
{% if ogImageAlt %}<meta property="og:image:alt" content="{{ ogImageAlt }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">

{% for locale in alternateLocales %}
<link rel="alternate" hreflang="{{ locale.code }}" href="{{ locale.url }}">
{% endfor %}

{#- Built as objects so escaping and commas are the serializer's job, not the template's. -#}
{% set organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": site.title,
  "url": site.url,
  "description": site.description,
  "sameAs": site.sameAs
} %}
<script type="application/ld+json">{{ organization | json | safe }}</script>
{% if schemaEvent %}
{% set event = {
  "@context": "https://schema.org",
  "@type": "Event",
  "name": schemaEvent.name,
  "description": schemaEvent.description,
  "startDate": schemaEvent.startDate | dateISO,
  "endDate": schemaEvent.endDate | dateISO,
  "image": schemaEvent.image,
  "location": { "@type": "Place", "name": schemaEvent.locationName, "address": schemaEvent.locationAddress },
  "organizer": { "@type": "Organization", "name": site.title, "url": site.url }
} %}
<script type="application/ld+json">{{ event | json | safe }}</script>
{% endif %}
