<article class="event-card" data-component="event-card" data-type="event" itemscope itemtype="https://schema.org/Event">
  
  {% if image %}
    <figure class="event-card__image">
      <img src="{{ image }}" alt="" loading="lazy" itemprop="image" />
    </figure>
  {% endif %}

  <div class="event-card__body">
    <h3 class="event-card__title" itemprop="name"></h3>
    
    <div class="event-card__meta">
      <time class="event-card__date" itemprop="startDate" datetime=""></time>
      <span class="event-card__location" itemprop="location"></span>
    </div>

    <p class="event-card__description" itemprop="description"></p>

    {% if category %}
      <span class="event-card__category" data-category="{{ category }}"></span>
    {% endif %}

    <div class="event-card__actions">
      <a class="event-card__link" href="#">Details</a>
      {% if rsvp %}
        <button class="event-card__rsvp" type="button" itemprop="rsvp">RSVP</button>
      {% endif %}
    </div>
  </div>

</article>
