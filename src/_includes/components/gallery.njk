<section class="gallery" data-component="gallery" data-layout="{{ layout or 'grid' }}">
  
  <div class="gallery__grid">
    {% for item in items %}
      <figure class="gallery__item">
        <img src="{{ item.image }}" alt="{{ item.alt or '' }}" loading="lazy" />
        {% if item.caption %}
          <figcaption class="gallery__caption">{{ item.caption }}</figcaption>
        {% endif %}
      </figure>
    {% endfor %}
  </div>

</section>
